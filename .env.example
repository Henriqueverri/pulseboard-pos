# Valores de desenvolvimento local. Nunca coloque credenciais reais neste arquivo.
# O Docker Compose le um `.env` na raiz automaticamente; a API le as mesmas variaveis do ambiente
# (os defaults de application.yml ja batem com os valores abaixo).

# PostgreSQL do Docker Compose
POS_DB_NAME=pulseboard_pos
POS_DB_USER=pos
POS_DB_PASSWORD=pos
POS_DB_PORT=5433

# API (Spring Boot)
POS_DB_URL=jdbc:postgresql://localhost:5433/pulseboard_pos
SERVER_PORT=8080
POS_CURRENCY=BRL

# Autenticacao (JWT HS256). O segredo e obrigatorio e precisa de pelo menos 32 bytes; gere um
# valor proprio, por exemplo com `openssl rand -base64 48`. Os usuarios abaixo sao criados no
# startup (nao ha cadastro); troque as senhas fora do ambiente local.
POS_JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
POS_ADMIN_EMAIL=admin@pos.example
POS_ADMIN_PASSWORD=admin-dev-password
POS_ADMIN_NAME=Administrador
POS_CASHIER_EMAIL=caixa@pos.example
POS_CASHIER_PASSWORD=caixa-dev-password
POS_CASHIER_NAME=Caixa

# Integracao com o PulseBoard (outbox). A API Key e criada no PulseBoard, em Integracao -> API Keys
# (formato pb_<prefixo>_<segredo>); defina-a so no seu ambiente, nunca neste arquivo. Sem chave, ou com
# PULSEBOARD_INTEGRATION_ENABLED=false, o POS funciona normalmente e os eventos ficam PENDING.
PULSEBOARD_INTEGRATION_ENABLED=true
PULSEBOARD_API_URL=http://localhost:8000/api/v1
PULSEBOARD_API_KEY=
