# Valores de desenvolvimento local. Nunca coloque credenciais reais neste arquivo.
#
# Uso: `cp .env.example .env`. O Docker Compose le o `.env` da raiz automaticamente. Para rodar a API
# fora do Docker (`./mvnw spring-boot:run`), carregue o mesmo arquivo no shell:
# `set -a; source .env; set +a`.
#
# [obrigatoria] precisa ter valor; [opcional] tem padrao (indicado) e pode ficar comentada.

# --- PostgreSQL (Compose) -------------------------------------------------------------------------
POS_DB_NAME=pulseboard_pos          # [opcional] padrao pulseboard_pos
POS_DB_USER=pos                     # [opcional] padrao pos
POS_DB_PASSWORD=pos                 # [opcional] padrao pos (so para desenvolvimento local)
POS_DB_PORT=5433                    # [opcional] porta no host; 5433 para nao colidir com o PulseBoard

# --- Portas do Compose no host ------------------------------------------------------------------
# POS_WEB_PORT=8088                 # [opcional] POS Web (Nginx): http://localhost:8088
# POS_API_PORT=8080                 # [opcional] API direta (Swagger, curl)

# --- API fora do Docker ---------------------------------------------------------------------------
# No Compose a API usa o servico `db` e ignora estas duas.
POS_DB_URL=jdbc:postgresql://localhost:5433/pulseboard_pos   # [opcional]
SERVER_PORT=8080                    # [opcional]

# --- API --------------------------------------------------------------------------------------------
POS_CURRENCY=BRL                    # [opcional] precisa ser a moeda da organizacao no PulseBoard
# POS_LOG_FORMAT=logstash           # [opcional] logs JSON (logstash, ecs, gelf); vazio = texto simples

# --- Autenticacao (JWT HS256) ---------------------------------------------------------------------
# [obrigatoria] pelo menos 32 bytes; gere um valor proprio com `openssl rand -base64 48`.
POS_JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789

# Usuarios criados (ou sincronizados) no startup; nao ha cadastro. Troque as senhas fora do ambiente
# local. ADMIN e [obrigatorio] no Compose; CASHIER e [opcional] (sem e-mail/senha, nao e criado).
POS_ADMIN_EMAIL=admin@pos.example
POS_ADMIN_PASSWORD=admin-dev-password
POS_ADMIN_NAME=Administrador
POS_CASHIER_EMAIL=caixa@pos.example
POS_CASHIER_PASSWORD=caixa-dev-password
POS_CASHIER_NAME=Caixa

# --- Integracao com o PulseBoard (outbox) -------------------------------------------------------
# Sem chave, ou com PULSEBOARD_INTEGRATION_ENABLED=false, o POS funciona normalmente e os eventos
# ficam PENDING ate a integracao ser ligada.
PULSEBOARD_INTEGRATION_ENABLED=true # [opcional] padrao true
# [opcional] padrao: http://host.docker.internal:8000/api/v1 no Compose (PulseBoard rodando no host)
# e http://localhost:8000/api/v1 fora dele. Producao: https://api.henriqueverri.dev/api/v1
# PULSEBOARD_API_URL=
# [opcional] API Key "pb_<prefixo>_<segredo>" criada no PulseBoard em Integracao -> API Keys.
# Defina so no seu `.env` local (ignorado pelo git), nunca neste arquivo.
PULSEBOARD_API_KEY=
# POS_OUTBOX_POLL_INTERVAL=2s       # [opcional] intervalo do worker
# POS_OUTBOX_MAX_ATTEMPTS=10        # [opcional] tentativas antes de FAILED/EXHAUSTED
